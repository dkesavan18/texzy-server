# Application
NODE_ENV=development
PORT=3000

# PostgreSQL (existing Texzy database — do not recreate schema)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=texzy

# TypeORM — MUST stay false so NestJS never creates/drops/alters tables
DB_SYNCHRONIZE=false
DB_LOGGING=true

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_GOOGLE_REGISTRATION_SECRET=change_me_google_reg_secret_min_32
JWT_GOOGLE_REGISTRATION_EXPIRES_IN=10m

# Google Sign-In (OAuth client IDs — never hard-code)
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Cloudflare R2 (S3-compatible object storage — image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=texzy-media
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
R2_PRESIGNED_URL_EXPIRES_SECONDS=300
# If you switch the webapp back to direct browser PUT (uploadUrl from /presign),
# add a CORS policy on the R2 bucket allowing your web origins + PUT/HEAD/GET.
# Example AllowedOrigins: http://localhost:5173, https://your-app.example.com

# Upload limits
UPLOAD_MAX_FILE_SIZE_BYTES=8388608
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Thumbnail generation
THUMBNAIL_MAX_WIDTH=800
THUMBNAIL_QUALITY=85

# Firebase Admin SDK (server-side web push sender for the Texzy Inbox)
# Firebase Console -> Project settings -> Service accounts -> Generate new private key (downloads a JSON file).
# Copy project_id / client_email / private_key from that JSON. Keep the \n escapes in FIREBASE_PRIVATE_KEY as-is.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# Razorpay (Buy Now payments) — Test Mode keys from Dashboard > Settings > API Keys.
# NEVER put live keys here. RAZORPAY_KEY_SECRET must never be sent to the frontend.
RAZORPAY_KEY_ID=rzp_test_TXBC2ksUjXXOLR
RAZORPAY_KEY_SECRET=1bQSwx5RFSwjZYHgRo6Q7A8I
# Dashboard > Settings > Webhooks > (your webhook) > Secret. Only usable once the API has a public URL.
RAZORPAY_WEBHOOK_SECRET=
