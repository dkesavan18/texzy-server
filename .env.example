# Application
NODE_ENV=development
PORT=3000

# PostgreSQL (existing Texzy database — do not recreate schema)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=texzy

# TypeORM — MUST stay false so NestJS never creates/drops/alters tables
DB_SYNCHRONIZE=false
DB_LOGGING=true

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_GOOGLE_REGISTRATION_SECRET=change_me_google_reg_secret_min_32
JWT_GOOGLE_REGISTRATION_EXPIRES_IN=10m

# Google Sign-In (OAuth client IDs — never hard-code)
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
